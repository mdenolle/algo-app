# The UI does not change when this is switched.
# Allowed values: demo | on-device | remote
EXPO_PUBLIC_VISION_PROVIDER=demo

# A label for the selected model. For an on-device build, this should match the
# model packaged by the native runner.
EXPO_PUBLIC_VISION_MODEL=algo-lego-detector-v1

# Used only for the remote provider. Point this at a parent-controlled backend;
# never put a secret AI key in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_VISION_ENDPOINT=https://example.com/algo/scan

# Algo World screen. Default: the published site (works with the laptop off).
# Use "lan" to load it from this laptop's server (npm run web) while developing,
# or any full URL.
EXPO_PUBLIC_WORLD_URL=
